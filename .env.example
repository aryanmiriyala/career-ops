# LLM provider keys for low-cost resume/application pipeline experiments.
# Copy the keys you use into .env. Do not commit real secret values.

# Aggregators / routers
OPENROUTER_API_KEY=
OPEN_ROUTER_KEY=
FEATHERLESS_API_KEY=
OPENCODE_API_KEY=
ZAI_API_KEY=
# Existing ZAI_KEY is also supported.

# Direct low-cost providers
CEREBRAS_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
TOGETHER_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
HUGGINGFACE_API_KEY=
MISTRAL_API_KEY=

# Optional higher-quality/final-review providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional observability / cost tracking
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGFUSE_BASE_URL=

# Optional local model endpoints
OLLAMA_BASE_URL=http://localhost:11434
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LOCAL_OPENAI_COMPATIBLE_BASE_URL=
LOCAL_OPENAI_COMPATIBLE_API_KEY=

# Optional Supabase Auth. Leave blank for single-owner local login.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key can be used instead. Never use a service-role key here.
SUPABASE_ANON_KEY=
SUPABASE_ALLOWED_EMAIL=
